    "m_SourceType": 0,
    "m_FunctionName": "AllAdditionalLights",
    "m_FunctionSource": "5a909633526ea5742b6be6e5ff96c133",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "#include \"Packages/com.unity.render-pipelines.universal/ShaderLibrary/Lighting.hlsl\"\r\n\r\nvoid ToonLightingMulti_float(\r\n    float3 NormalWS,\r\n    float3 PositionWS,\r\n    out float3 Color)\r\n{\r\n    float3 result = 0;\r\n\r\n    // ===== MAIN LIGHT =====\r\n    Light mainLight = GetMainLight();\r\n    float NdotL = saturate(dot(NormalWS, mainLight.direction));\r\n\r\n    // Toon step (2 bands example)\r\n    float toon = step(0.5, NdotL);\r\n\r\n    result += toon * mainLight.color;\r\n\r\n    // ===== ADDITIONAL LIGHTS =====\r\n    uint lightCount = GetAdditionalLightsCount();\r\n\r\n    for (uint i = 0; i < lightCount; i++)\r\n    {\r\n        Light light = GetAdditionalLight(i, PositionWS);\r\n\r\n        float NdotL_add = saturate(dot(NormalWS, light.direction));\r\n\r\n        float toon_add = step(0.5, NdotL_add);\r\n\r\n        result += toon_add * light.color * light.distanceAttenuation;\r\n    }\r\n\r\n    Color = result;\r\n}"
}

