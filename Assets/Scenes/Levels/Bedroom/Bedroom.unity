  dialogueUI: {fileID: 938271971}
  dialogueText: {fileID: 1988827273}
  continuePrompt: {fileID: 0}
  lines:
  - Kohaku is that you!?
  - I thought you were gone! Where have you been?
  - What am i doing here? I was running away from the shredders goons and ended up
    here.
  - The day you disapeared this "shredder" guy appeared with some goons and started
    going after all of us.
  - He was saying something about spring cleaning, i really thought he got you too
    as well.
  - I managed to escape up here, but AI and Ellie werent so lucky and got captured...
  - You want to rescue them!? Well... i would come with you but im not sure i would
    be of any help...
  - Here. Have this. Im sure its going to help you on your journey.
  - Im going to stay here where its safe, good luck!
  typingSpeed: 0.03
  popSpeed: 6
  popScale: 1.2
  audioSource: {fileID: 0}
