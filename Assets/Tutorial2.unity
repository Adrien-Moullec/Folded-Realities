  dialogueUI: {fileID: 152716384}
  dialogueText: {fileID: 1910566594}
  continuePrompt: {fileID: 614631055}
  lines:
  - "My name\u2019s Sully. You see these arms? I\u2019m an Origami, just like you. "
  - " And I got thrown out. It\u2019s the spring cleaning season."
  - "We are ALL going in this bin by the end of the day. And there\u2019s no way
    out. "
  - This is it, kid. Deal with it.
  typingSpeed: 0.03
  popSpeed: 6
  popScale: 1.2
